# Machine-specific paths — never hardcode these in code or commit real values.
# Copy this to .env (gitignored) and fill in your actual paths.

# Installed PC game directory (contains XMen2.exe, libIG*.dll, Data/, Textures/...)
GAME_PC_DIR="/path/to/X-Men Legends II"

# Xbox original disc ISO (XDVDFS). Source of authentic Xbox button glyphs + native layout.
XBOX_ISO="/path/to/xmen-legends-2.iso"

# Wine prefix used by the differential harness. Must have DXVK's d3d8.dll:
# a bare `wineboot -u` prefix has no d3d8 at all and the game fails at load.
# A Lutris-provisioned prefix for the game works.
WINE_PREFIX="/path/to/your/wineprefix"

# Where the native host keeps its emulated Windows registry. Defaults to
# scratch/x2registry.txt; never point this inside the game install, which this
# project treats as read-only.
#X2_REGISTRY="scratch/x2registry.txt"
