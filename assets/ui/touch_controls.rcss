*, *:before, *:after {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
    font-family: "LatoLatin";
}

.touch-zone {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2dp rgba(220, 238, 255, 42%);
    border-radius: 18dp;
    background-color: rgba(15, 25, 48, 34%);
    opacity: 0.68;
}

.touch-zone.stick {
    border-radius: 512dp;
    background-color: rgba(15, 25, 48, 24%);
}

.touch-zone.active {
    border-color: rgba(112, 231, 249, 88%);
    background-color: rgba(40, 115, 145, 58%);
    opacity: 1;
}

.touch-label {
    color: rgba(244, 249, 255, 94%);
    font-size: 16dp;
    text-align: center;
}

.touch-stick-knob {
    width: 38%;
    height: 38%;
    border: 2dp rgba(220, 238, 255, 55%);
    border-radius: 256dp;
    background-color: rgba(82, 116, 148, 38%);
}
