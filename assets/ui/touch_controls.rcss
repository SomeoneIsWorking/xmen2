*, *:before, *:after {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
    font-family: "LatoLatin";
}

.touch-zone {
    position: absolute;
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    border: 2dp rgba(220, 238, 255, 38%);
    border-radius: 512dp;
    background-color: rgba(15, 23, 42, 48%);
    opacity: 0.76;
}

.touch-zone.stick {
    border: 2.5dp rgba(186, 230, 253, 35%);
    border-radius: 512dp;
    background-color: rgba(15, 23, 42, 26%);
}

.touch-stick-knob {
    width: 44%;
    height: 44%;
    border: 2.5dp rgba(224, 242, 254, 80%);
    border-radius: 512dp;
    background-color: rgba(56, 189, 248, 35%);
}

.touch-zone.active {
    border-color: rgba(112, 231, 249, 95%);
    background-color: rgba(14, 116, 144, 70%);
    opacity: 1;
}

/* Ability accent colors */
.touch-zone.zone-light {
    border-color: rgba(56, 189, 248, 55%);
}
.touch-zone.zone-light.active,
.powers-active .touch-zone.zone-light {
    border-color: #38BDF8;
    background-color: rgba(2, 132, 199, 55%);
    opacity: 0.95;
}

.touch-zone.zone-heavy {
    border-color: rgba(245, 158, 11, 55%);
}
.touch-zone.zone-heavy.active,
.powers-active .touch-zone.zone-heavy {
    border-color: #F59E0B;
    background-color: rgba(180, 83, 9, 55%);
    opacity: 0.95;
}

.touch-zone.zone-use {
    border-color: rgba(34, 197, 94, 55%);
}
.touch-zone.zone-use.active,
.powers-active .touch-zone.zone-use {
    border-color: #22C55E;
    background-color: rgba(21, 128, 61, 55%);
    opacity: 0.95;
}

.touch-zone.zone-jump {
    border-color: rgba(168, 85, 247, 55%);
}
.touch-zone.zone-jump.active,
.powers-active .touch-zone.zone-jump {
    border-color: #A855F7;
    background-color: rgba(126, 34, 206, 55%);
    opacity: 0.95;
}

.touch-zone.zone-powers {
    border-color: rgba(244, 63, 94, 60%);
    background-color: rgba(225, 29, 72, 35%);
}
.touch-zone.zone-powers.active,
.powers-active .touch-zone.zone-powers {
    border-color: #F43F5E;
    background-color: rgba(225, 29, 72, 70%);
    opacity: 1;
}

.touch-zone.zone-pause {
    border-radius: 14dp;
    border-color: rgba(148, 163, 184, 45%);
}

.touch-icon {
    width: 44%;
    height: 44%;
    display: block;
    margin: 0 auto;
    pointer-events: none;
}

.touch-label {
    color: rgba(244, 249, 255, 96%);
    font-size: 11dp;
    font-weight: bold;
    text-align: center;
    margin-top: 2dp;
    text-transform: uppercase;
    letter-spacing: 0.5dp;
}

.touch-badge {
    position: absolute;
    top: 4dp;
    right: 8dp;
    font-size: 9dp;
    font-weight: bold;
    padding: 1dp 4dp;
    border-radius: 5dp;
    color: #FFFFFF;
    background-color: rgba(15, 23, 42, 80%);
    border: 1dp rgba(255, 255, 255, 35%);
}

.touch-badge.p1 {
    color: #BAE6FD;
    border-color: #38BDF8;
    background-color: rgba(2, 132, 199, 65%);
}

.touch-badge.p2 {
    color: #FEF3C7;
    border-color: #F59E0B;
    background-color: rgba(180, 83, 9, 65%);
}

.touch-badge.p3 {
    color: #D1FAE5;
    border-color: #10B981;
    background-color: rgba(4, 120, 87, 65%);
}

.touch-badge.p4 {
    color: #F3E8FF;
    border-color: #A855F7;
    background-color: rgba(109, 40, 217, 65%);
}
