*, *:before, *:after {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
    font-family: "LatoLatin";
}

.touch-zone {
    position: absolute;
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    border: 2dp rgba(220, 238, 255, 72%);
    border-radius: 512dp;
    background-color: rgba(10, 18, 29, 72%);
    opacity: 1;
}

.touch-zone.stick {
    border: 2dp rgba(186, 230, 253, 55%);
    border-radius: 512dp;
    background-color: rgba(10, 18, 29, 32%);
}

/* Positioned from the live deflection by the document each frame, so the
   knob shows where the thumb has pushed the stick. */
.touch-stick-knob {
    position: absolute;
    width: 38%;
    height: 38%;
    border: 2dp rgba(224, 242, 254, 90%);
    border-radius: 512dp;
    background-color: rgba(56, 189, 248, 45%);
}

.touch-zone.active {
    border-color: rgba(112, 231, 249, 95%);
    background-color: rgba(14, 116, 144, 70%);
    opacity: 1;
}

/* Each action's ring takes its prompt glyph's colour -- the Xbox face
   colours the game's own prompts are drawn in -- so the circle and the glyph
   inside it read as one control. */
.touch-zone.zone-light {
    border-color: rgba(95, 177, 58, 85%);
}
.touch-zone.zone-light.active {
    border-color: #5FB13A;
    background-color: rgba(95, 177, 58, 45%);
}

.touch-zone.zone-heavy {
    border-color: rgba(209, 59, 51, 85%);
}
.touch-zone.zone-heavy.active {
    border-color: #D13B33;
    background-color: rgba(209, 59, 51, 45%);
}

.touch-zone.zone-use {
    border-color: rgba(46, 109, 180, 85%);
}
.touch-zone.zone-use.active {
    border-color: #2E6DB4;
    background-color: rgba(46, 109, 180, 45%);
}

.touch-zone.zone-jump {
    border-color: rgba(232, 178, 31, 85%);
}
.touch-zone.zone-jump.active {
    border-color: #E8B21F;
    background-color: rgba(232, 178, 31, 45%);
}

/* A power: the game's own round icon, filling the circle it is outlined by. */
.touch-zone.zone-power {
    border-color: rgba(220, 238, 255, 80%);
    background-color: rgba(10, 18, 29, 45%);
}
.touch-zone.zone-power.active {
    border-color: #FFFFFF;
    background-color: rgba(255, 255, 255, 30%);
}

.touch-power-icon {
    width: 92%;
    height: 92%;
    display: block;
    pointer-events: none;
}

.touch-zone.zone-pause {
    border-color: rgba(220, 220, 220, 60%);
}

.touch-icon {
    width: 50%;
    height: 50%;
    display: block;
    margin: 0 auto;
    pointer-events: none;
}

.touch-label {
    color: rgba(244, 249, 255, 96%);
    font-size: 10dp;
    font-weight: bold;
    text-align: center;
    margin-top: 2dp;
    text-transform: uppercase;
    letter-spacing: 0.2dp;
}


.touch-zone.zone-light {
    border-width: 3dp;
}

.touch-zone.stick.active .touch-stick-knob {
    background-color: rgba(125, 232, 255, 85%);
    border-color: #FFFFFF;
}

.touch-zone.zone-pause .touch-label {
    display: none;
}

/*
 * A rewritten retail action prompt: "Esc Back" with the key taken off.
 *
 * The GAME still draws the words, underneath this element and in its own
 * font, so this is deliberately an empty outline -- a filled background would
 * cover the very text that says what the control does. It is drawn where the
 * words landed, grown to something a thumb can hit.
 */
.touch-zone.prompt {
    border: 2dp rgba(220, 238, 255, 80%);
    border-radius: 8dp;
    background-color: rgba(10, 18, 29, 28%);
}

.touch-zone.prompt.active {
    border-color: rgba(112, 231, 249, 95%);
    background-color: rgba(14, 116, 144, 45%);
}
