*, *:before, *:after {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
    font-family: "LatoLatin";
}

.touch-zone {
    position: absolute;
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    border: 2dp rgba(220, 238, 255, 72%);
    border-radius: 512dp;
    background-color: rgba(10, 18, 29, 72%);
    opacity: 1;
}

.touch-zone.stick {
    border: 2dp rgba(186, 230, 253, 55%);
    border-radius: 512dp;
    background-color: rgba(10, 18, 29, 32%);
}

/* Positioned from the live deflection by the document each frame, so the
   knob shows where the thumb has pushed the stick. */
.touch-stick-knob {
    position: absolute;
    width: 38%;
    height: 38%;
    border: 2dp rgba(224, 242, 254, 90%);
    border-radius: 512dp;
    background-color: rgba(56, 189, 248, 45%);
}

.touch-zone.active {
    border-color: rgba(112, 231, 249, 95%);
    background-color: rgba(14, 116, 144, 70%);
    opacity: 1;
}

/* A button: a power's own round icon from the hero's atlas, or the port's
   neon line art for attack, smash, use, jump and the port menu, filling the
   circle it is outlined by. */
.touch-zone.zone-icon {
    border-color: rgba(220, 238, 255, 80%);
    background-color: rgba(10, 18, 29, 45%);
}
.touch-zone.zone-icon.active {
    border-color: #FFFFFF;
    background-color: rgba(255, 255, 255, 30%);
}

.touch-icon {
    width: 92%;
    height: 92%;
    display: block;
    pointer-events: none;
}

/* A hero portrait, a potion or a menu icon: the game draws the art itself,
   under this element, so the control is the same ring with nothing filling
   it. The port menu beside the game's menu icons is drawn the same way. */
.touch-zone.zone-ring {
    border-color: rgba(220, 238, 255, 80%);
    background-color: rgba(0, 0, 0, 0%);
}
.touch-zone.zone-ring.active {
    border-color: #FFFFFF;
    background-color: rgba(255, 255, 255, 22%);
}

/* A menu pad button: the shared Xbox glyph is the whole button, drawn with
   no plate or outline of its own; a press lights the round behind it. */
.touch-zone.zone-glyph {
    border-width: 0dp;
    background-color: rgba(0, 0, 0, 0%);
}
.touch-zone.zone-glyph.active {
    background-color: rgba(255, 255, 255, 35%);
}

.touch-zone.stick.active .touch-stick-knob {
    background-color: rgba(125, 232, 255, 85%);
    border-color: #FFFFFF;
}
