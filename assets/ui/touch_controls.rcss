*, *:before, *:after {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
    font-family: "LatoLatin";
}

.touch-zone {
    position: absolute;
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    border: 2dp rgba(220, 238, 255, 72%);
    border-radius: 512dp;
    background-color: rgba(10, 18, 29, 72%);
    opacity: 1;
}

.touch-zone.stick {
    border: 2dp rgba(186, 230, 253, 55%);
    border-radius: 512dp;
    background-color: rgba(10, 18, 29, 32%);
}

.touch-stick-knob {
    width: 38%;
    height: 38%;
    border: 2dp rgba(224, 242, 254, 90%);
    border-radius: 512dp;
    background-color: rgba(56, 189, 248, 45%);
}

.touch-zone.active {
    border-color: rgba(112, 231, 249, 95%);
    background-color: rgba(14, 116, 144, 70%);
    opacity: 1;
}

/* Ability accent colors */
.touch-zone.zone-light {
    border-color: rgba(56, 189, 248, 85%);
}
.touch-zone.zone-light.active,
.powers-active .touch-zone.zone-light {
    border-color: #38BDF8;
    background-color: rgba(2, 132, 199, 55%);
    opacity: 1;
}

.touch-zone.zone-heavy {
    border-color: rgba(245, 158, 11, 85%);
}
.touch-zone.zone-heavy.active,
.powers-active .touch-zone.zone-heavy {
    border-color: #F59E0B;
    background-color: rgba(180, 83, 9, 55%);
    opacity: 1;
}

.touch-zone.zone-use {
    border-color: rgba(34, 197, 94, 85%);
}
.touch-zone.zone-use.active,
.powers-active .touch-zone.zone-use {
    border-color: #22C55E;
    background-color: rgba(21, 128, 61, 55%);
    opacity: 1;
}

.touch-zone.zone-jump {
    border-color: rgba(168, 85, 247, 85%);
}
.touch-zone.zone-jump.active,
.powers-active .touch-zone.zone-jump {
    border-color: #A855F7;
    background-color: rgba(126, 34, 206, 55%);
    opacity: 1;
}

.touch-zone.zone-powers {
    border-color: rgba(244, 63, 94, 85%);
    background-color: rgba(74, 16, 34, 72%);
}
.touch-zone.zone-powers.active,
.powers-active .touch-zone.zone-powers {
    border-color: #F43F5E;
    background-color: rgba(225, 29, 72, 70%);
    opacity: 1;
}

.touch-zone.zone-pause {
    border-radius: 14dp;
    border-color: rgba(148, 163, 184, 45%);
}

.touch-icon {
    width: 55%;
    height: 55%;
    display: block;
    margin: 0 auto;
    pointer-events: none;
}

.touch-label {
    color: rgba(244, 249, 255, 96%);
    font-size: 10dp;
    font-weight: bold;
    text-align: center;
    margin-top: 2dp;
    text-transform: uppercase;
    letter-spacing: 0.2dp;
}


.touch-zone.zone-light {
    border-width: 3dp;
}

.touch-zone.stick.active .touch-stick-knob {
    background-color: rgba(125, 232, 255, 85%);
    border-color: #FFFFFF;
}

.touch-zone.zone-pause .touch-label {
    display: none;
}
