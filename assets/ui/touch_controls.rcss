*, *:before, *:after {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
    font-family: "LatoLatin";
}

.touch-zone {
    position: absolute;
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    border: 2dp rgba(220, 238, 255, 72%);
    border-radius: 512dp;
    background-color: rgba(10, 18, 29, 72%);
    opacity: 1;
}

.touch-zone.stick {
    border: 2dp rgba(186, 230, 253, 55%);
    border-radius: 512dp;
    background-color: rgba(10, 18, 29, 32%);
}

/* Positioned from the live deflection by the document each frame, so the
   knob shows where the thumb has pushed the stick. */
.touch-stick-knob {
    position: absolute;
    width: 38%;
    height: 38%;
    border: 2dp rgba(224, 242, 254, 90%);
    border-radius: 512dp;
    background-color: rgba(56, 189, 248, 45%);
}

.touch-zone.active {
    border-color: rgba(112, 231, 249, 95%);
    background-color: rgba(14, 116, 144, 70%);
    opacity: 1;
}

/* A button: the game's own round icon -- a power's, or the talent and HUD
   art for attack, smash, use, jump and pause -- filling the circle it is
   outlined by. */
.touch-zone.zone-icon {
    border-color: rgba(220, 238, 255, 80%);
    background-color: rgba(10, 18, 29, 45%);
}
.touch-zone.zone-icon.active {
    border-color: #FFFFFF;
    background-color: rgba(255, 255, 255, 30%);
}

.touch-game-icon {
    width: 92%;
    height: 92%;
    display: block;
    pointer-events: none;
}

/* A hero portrait or a potion: the game draws the art itself, under this
   element, so the control is the same ring with nothing filling it. */
.touch-zone.zone-ring {
    border-color: rgba(220, 238, 255, 80%);
    background-color: rgba(0, 0, 0, 0%);
}
.touch-zone.zone-ring.active {
    border-color: #FFFFFF;
    background-color: rgba(255, 255, 255, 22%);
}

.touch-label {
    color: rgba(244, 249, 255, 96%);
    font-size: 10dp;
    font-weight: bold;
    text-align: center;
    margin-top: 2dp;
    text-transform: uppercase;
    letter-spacing: 0.2dp;
}


.touch-zone.stick.active .touch-stick-knob {
    background-color: rgba(125, 232, 255, 85%);
    border-color: #FFFFFF;
}

/*
 * A rewritten retail action prompt: "Esc Back" with the key taken off.
 *
 * The GAME still draws the words, underneath this element and in its own
 * font, so this is deliberately an empty outline -- a filled background would
 * cover the very text that says what the control does. It is drawn where the
 * words landed, grown to something a thumb can hit.
 */
.touch-zone.prompt {
    border: 2dp rgba(220, 238, 255, 80%);
    border-radius: 8dp;
    background-color: rgba(10, 18, 29, 28%);
}

.touch-zone.prompt.active {
    border-color: rgba(112, 231, 249, 95%);
    background-color: rgba(14, 116, 144, 45%);
}
