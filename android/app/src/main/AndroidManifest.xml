<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The product target always opens the agent control channel, and creating
         any socket needs this permission's `inet` group: without it socket()
         fails with EACCES and control_start() exits before the game runs. The
         channel binds 127.0.0.1 only, so nothing leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- hasFragileUserData: the imported game installation lives in
         app-private storage and is gigabytes the player copied in by hand, so
         an uninstall must OFFER to keep it rather than silently destroying it
         (API 29+). It is the safety net, not the fix: a published APK signed
         with a stable key updates in place and never reaches this path. -->
    <application
        android:icon="@drawable/xmen2_port_icon"
        android:label="X-Men Legends II"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:supportsRtl="true">
        <activity
            android:name=".XMen2GameActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".XMen2SetupActivity"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="io.github.someoneisworking.android.AndroidImportService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
