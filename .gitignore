.env
scratch/
# default game install location (AGENTS.md: game assets are never committed)
/game/
*.zip
android/.gradle/
build/
tools/raven-formats/
*.o
*.a
*.so
*.egg-info
__pycache__/
# Jython compiles an imported sibling module (caselabel.py) next to it
*$py.class

# published by bootstrap.py at every provision, never committed.
# font_tier_ratio.h is MEASURED FROM THE PLAYER'S OWN INSTALL -- committing it
# would put install-derived font metrics of shipped game data in the tree, and
# it is not even the same number for every localisation.
# prompt_glyph_atlas.h is rasterised from the shared port-assets SVGs; a
# committed copy would read as current while the shared sets moved on.
src/gen/font_tier_ratio.h
src/gen/prompt_glyph_atlas.h

# optional Xbox toolkit checkout; the maintained fork already contains its changes
vendor/

# host run state -- the emulated Windows registry (see src/native/advapi32.c).
# It defaults into the OS user config directory, but keep the old root-level
# name ignored so a stale binary cannot re-commit it.
x2registry.txt
