#ifndef X2_INSTALL_REQUIREMENTS_H
#define X2_INSTALL_REQUIREMENTS_H

/* Generated from CMake's X2_MODULES and X2_INSTALL_REQUIRED_CONTENT lists.
 * The loader and packaged setup agree on both the original PC images and the
 * content sentinels that make a selected install launchable. */
static const char *const x2_install_required_images[] = {
    "@X2_INSTALL_REQUIRED_IMAGES_LITERAL@"
};

#define X2_INSTALL_REQUIRED_IMAGE_COUNT \
    ((unsigned)(sizeof x2_install_required_images / sizeof x2_install_required_images[0]))

static const char *const x2_install_required_content[] = {
    "@X2_INSTALL_REQUIRED_CONTENT_LITERAL@"
};

#define X2_INSTALL_REQUIRED_CONTENT_COUNT \
    ((unsigned)(sizeof x2_install_required_content / sizeof x2_install_required_content[0]))

#endif /* X2_INSTALL_REQUIREMENTS_H */
