+/* ── NtQueryVirtualMemory (ordinal 217, 2 args = 8 bytes) ──
+ *
+ * NTSTATUS NtQueryVirtualMemory(PVOID BaseAddress,
+ *                               PMEMORY_BASIC_INFORMATION MemoryInformation)
+ *
+ * The Xbox form takes two arguments, not the six of the NT one, and the
+ * struct is written into GUEST memory. There was no bridge at all, so the
+ * call returned 0 with the caller's buffer untouched -- and the caller walks
+ * the address space by adding RegionSize, so a RegionSize of zero is an
+ * infinite loop. It spun over two billion times.
+ *
+ * The answer has to come from OUR memory layout: the host's VirtualQuery
+ * knows nothing about guest VAs. Regions are reported page-granular from the
+ * layout the loader actually built.
+ */
+static void bridge_NtQueryVirtualMemory(void)
+{
+    uint32_t addr    = STACK_ARG(0);
+    uint32_t info_va = STACK_ARG(1);
+
+    /* [lo, hi) of the guest's committed regions, in address order. */
+    static const struct { uint32_t lo, hi; } regions[] = {
+        { XBOX_BASE_ADDRESS, XBOX_STACK_BASE },  /* image + its data */
+        { XBOX_STACK_BASE,  XBOX_HEAP_BASE  },   /* thread stack */
+        { XBOX_HEAP_BASE,   XBOX_TOTAL_RAM  },   /* heap */
+    };
+    const int n = (int)(sizeof regions / sizeof regions[0]);
+    uint32_t page = addr & ~0xFFFu;
+    uint32_t base = 0, size = 0, state, protect, type;
+    int i, found = -1;
+
+    if (!info_va) { g_eax = 0xC000000Du; return; }   /* STATUS_INVALID_PARAMETER */
+
+    for (i = 0; i < n; i++)
+        if (page >= regions[i].lo && page < regions[i].hi) { found = i; break; }
+
+    if (found >= 0) {
+        base    = regions[found].lo;
+        size    = regions[found].hi - page;
+        state   = 0x1000;      /* MEM_COMMIT  */
+        protect = 0x04;        /* PAGE_READWRITE */
+        type    = 0x20000;     /* MEM_PRIVATE */
+    } else {
+        /* Free. RegionSize must reach the next region, and must never be
+           zero -- that is what made the caller spin. */
+        uint32_t next = 0xFFFFF000u;
+        for (i = 0; i < n; i++)
+            if (regions[i].lo > page && regions[i].lo < next) next = regions[i].lo;
+        base    = page;
+        size    = next - page;
+        state   = 0x10000;     /* MEM_FREE */
+        protect = 0x01;        /* PAGE_NOACCESS */
+        type    = 0;
+    }
+    if (size == 0) size = 0x1000;
+
+    BRIDGE_MEM32(info_va + 0x00) = page;      /* BaseAddress       */
+    BRIDGE_MEM32(info_va + 0x04) = base;      /* AllocationBase    */
+    BRIDGE_MEM32(info_va + 0x08) = protect;   /* AllocationProtect */
+    BRIDGE_MEM32(info_va + 0x0C) = size;      /* RegionSize        */
+    BRIDGE_MEM32(info_va + 0x10) = state;     /* State             */
+    BRIDGE_MEM32(info_va + 0x14) = protect;   /* Protect           */
+    BRIDGE_MEM32(info_va + 0x18) = type;      /* Type              */
+
+    g_eax = 0;   /* STATUS_SUCCESS */
+}
