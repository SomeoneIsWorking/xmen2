+/* ── HalReturnToFirmware (ordinal 49) ─────────────────────
+ * VOID HalReturnToFirmware(FIRMWARE_REENTRY Routine)
+ *
+ * On hardware this NEVER RETURNS -- it halts or reboots the console. With no
+ * bridge it returned 0 and execution carried on into code the title never
+ * intended to run, which reads in a log like a game that merely "finished".
+ * Say what happened and stop the thread's forward progress here.
+ */
+static void bridge_HalReturnToFirmware(void)
+{
+    static const char *routine[] = {
+        "HalHaltRoutine", "HalRebootRoutine", "HalQuickRebootRoutine",
+        "HalFatalErrorRebootRoutine", "HalResetSMCRoutine"
+    };
+    uint32_t r = STACK_ARG(0);
+
+    fprintf(stderr, "  [KERNEL] HalReturnToFirmware(%u = %s): THE TITLE ASKED TO "
+                    "REBOOT. It did not crash and it did not finish -- it gave up.\n",
+            r, r < 5 ? routine[r] : "unknown routine");
+    fflush(stderr);
+
+    g_eax = 0;
+}
