diff --git a/tools/validate_ordinals.py b/tools/validate_ordinals.py
index 04601e8..fc35707 100644
--- a/tools/validate_ordinals.py
+++ b/tools/validate_ordinals.py
@@ -24,6 +24,13 @@ ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
 PARSER = os.path.join(ROOT, 'tools/xbe_parser/xbe_parser.py')
 THUNKS = os.path.join(ROOT, 'src/kernel/kernel_thunks.c')
 DOCS = os.path.join(ROOT, 'docs/formats/kernel-exports.md')
+BRIDGE = os.path.join(ROOT, 'src/kernel/kernel_bridge.c')
+
+# Ordinals whose bridge deliberately shares one implementation with a
+# neighbour, so the name will not match. Each needs a reason.
+BRIDGE_ALIASES = {
+    150: ('KeSetTimer', 'KeSetTimerEx shares the KeSetTimer no-op bridge'),
+}
 
 
 def canonical():
@@ -49,6 +56,30 @@ def doc_rows():
     return out
 
 
+def bridge_cases():
+    """ordinal -> bridge function name, from kernel_bridge.c's dispatch."""
+    src = open(BRIDGE, encoding='utf-8', errors='replace').read()
+    return {int(o): fn for o, fn in
+            re.findall(r'case\s+(\d+):\s*return\s+bridge_(\w+);', src)}
+
+
+def argsize_cases():
+    """ordinal -> (bytes, name) from stdcall_args_for_ordinal's comments.
+
+    The stack cleanup size is per-FUNCTION, so a row labelled with the wrong
+    function is a wrong `ret N`: the simulated ESP drifts by the difference
+    and the caller resumes on a corrupted stack, far from the call.
+    """
+    src = open(BRIDGE, encoding='utf-8', errors='replace').read()
+    i = src.find('stdcall_args_for_ordinal')
+    if i < 0:
+        return {}
+    body = src[i:]
+    body = body[:body.find('\n}')]
+    return {int(o): (int(n), name) for o, n, name in
+            re.findall(r'case\s+(\d+):\s*return\s*(\d+);\s*/\*\s*(\w+)', body)}
+
+
 def main():
     table = canonical()
     errors = []
@@ -72,14 +103,42 @@ def main():
         if want and name != want:
             errors.append(f"docs:   ordinal {ordinal} is {want}, but documented as {name}")
 
+    for ordinal, fn in sorted(bridge_cases().items()):
+        want = table.get(ordinal)
+        alias = BRIDGE_ALIASES.get(ordinal)
+        if alias and alias[0] == fn:
+            continue
+        if want is None:
+            errors.append(f"bridge: ordinal {ordinal} (bridge_{fn}) is not in the export table")
+        elif fn != want:
+            belongs = next((o for o, n in table.items() if n == fn), None)
+            errors.append(
+                f"bridge: ordinal {ordinal} is {want}, but dispatches bridge_{fn}"
+                + (f" (which belongs at {belongs})" if belongs else ""))
+
+    for ordinal, (nbytes, name) in sorted(argsize_cases().items()):
+        want = table.get(ordinal)
+        if name.startswith('Unknown_'):
+            continue
+        if want is None:
+            errors.append(f"argsz:  ordinal {ordinal} ({name}) is not in the export table")
+        elif name != want:
+            belongs = next((o for o, n in table.items() if n == name), None)
+            errors.append(
+                f"argsz:  ordinal {ordinal} is {want}, but sized as {name} ({nbytes} bytes)"
+                + (f" (which belongs at {belongs})" if belongs else ""))
+
     if errors:
         print(f"FAIL: {len(errors)} ordinal mismatch(es)\n")
         for e in errors:
             print("  " + e)
         return 1
 
-    print(f"OK: {len(thunk_cases())} thunk cases and {len(doc_rows())} doc rows "
-          f"agree with the {len(table)}-entry export table")
+    print(f"OK: {len(thunk_cases())} thunk cases, {len(doc_rows())} doc rows, "
+          f"{len(bridge_cases())} bridge dispatches and {len(argsize_cases())} "
+          f"arg-size rows agree with the {len(table)}-entry export table")
+    print("  Not checked: whether each bridge BODY implements the semantics of "
+          "the name it carries -- only that the names line up.")
     return 0
 
 
