+/* Xbox WCHAR is UTF-16 (2 bytes). glibc's wchar_t is 4 bytes, so wcslen() is
+   the wrong function on Linux -- it reads 32-bit units and walks off the end of
+   a 16-bit string. MSVC happens to agree with WCHAR, which is why this compiled
+   on Windows. Count 16-bit units explicitly instead of relying on the host's
+   wchar_t width. */
+static size_t xbox_wcslen16(const WCHAR *s)
+{
+    size_t n = 0;
+    while (s[n]) n++;
+    return n;
+}
+
 VOID __stdcall xbox_RtlInitUnicodeString(PXBOX_UNICODE_STRING DestinationString, const WCHAR* SourceString)
 {
     if (SourceString) {
-        USHORT len = (USHORT)(wcslen(SourceString) * sizeof(WCHAR));
+        USHORT len = (USHORT)(xbox_wcslen16(SourceString) * sizeof(WCHAR));
         DestinationString->Length = len;
         DestinationString->MaximumLength = len + sizeof(WCHAR);
         DestinationString->Buffer = (PWCHAR)SourceString;
