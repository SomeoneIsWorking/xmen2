+++ b/src/platform/win32_compat.h
@@ -355,6 +355,17 @@ int   WideCharToMultiByte(UINT cp, DWORD flags, LPCWSTR wide, int wideCount,
 #define ERROR_GEN_FAILURE             31u
 #define ERROR_HANDLE_EOF              38u
 #define ERROR_NOT_SUPPORTED           50u
+/* Returned by ReleaseMutex when the caller does not own the mutex. Present in
+   winerror.h but missing from this Win32 vocabulary header, so kernel_sync.c
+   would not build on Linux. */
+#define ERROR_NOT_OWNER               288u
+
+/* Debugger primitives the kernel HAL calls. On Linux there is no Win32
+   debugger to ask, so report "no debugger" and raise SIGTRAP -- which is what
+   DebugBreak does on x86 anyway (int3). Reporting TRUE would make the game take
+   its debug paths. */
+static inline int IsDebuggerPresent(void) { return 0; }
+static inline void DebugBreak(void) { __builtin_trap(); }
