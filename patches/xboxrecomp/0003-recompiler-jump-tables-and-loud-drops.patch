+def bridge_cases():
+    """ordinal -> bridge function name, from kernel_bridge.c's dispatch."""
+    src = open(BRIDGE, encoding='utf-8', errors='replace').read()
+    return {int(o): fn for o, fn in
+            re.findall(r'case\s+(\d+):\s*return\s+bridge_(\w+);', src)}
+
+
+def argsize_cases():
+    """ordinal -> (bytes, name) from stdcall_args_for_ordinal's comments.
+
+    The stack cleanup size is per-FUNCTION, so a row labelled with the wrong
+    function is a wrong `ret N`: the simulated ESP drifts by the difference
+    and the caller resumes on a corrupted stack, far from the call.
+    """
+    src = open(BRIDGE, encoding='utf-8', errors='replace').read()
+    i = src.find('stdcall_args_for_ordinal')
+    if i < 0:
+        return {}
+    body = src[i:]
+    body = body[:body.find('\n}')]
+    return {int(o): (int(n), name) for o, n, name in
+            re.findall(r'case\s+(\d+):\s*return\s*(\d+);\s*/\*\s*(\w+)', body)}
+
+
+def dataexport_cases():
+    """ordinal -> name, from kernel_data_va_for_ordinal's trailing comments.
+
+    A shifted row here is worse than a wrong function: the game reads the
+    thunk and dereferences it, so a FUNCTION ordinal handed a data VA (or a
+    data ordinal handed the wrong struct) corrupts silently.
+    """
+    src = open(BRIDGE, encoding='utf-8', errors='replace').read()
+    i = src.find('kernel_data_va_for_ordinal')
+    if i < 0:
+        return {}
+    body = src[i:]
+    body = body[:body.find('\n}')]
+    return {int(o): name for o, name in
+            re.findall(r'case\s+(\d+):\s*return[^;]+;\s*/\*\s*(\w+)', body)}
+
+
