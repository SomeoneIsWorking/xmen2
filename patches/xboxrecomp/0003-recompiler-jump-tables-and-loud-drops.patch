diff --git a/tools/recomp/disasm.py b/tools/recomp/disasm.py
index 86c4364..a299392 100644
--- a/tools/recomp/disasm.py
+++ b/tools/recomp/disasm.py
@@ -136,6 +136,33 @@ def _parse_operand(cs, cs_op, insn_obj):
         return Operand(type="reg", reg=_reg_names.get(cs_op.reg, f"r{cs_op.reg}"))
 
 
+def _code_spans(start_va, end_va, data_ranges):
+    """[start_va, end_va) minus the data_ranges, as ordered code spans."""
+    if not data_ranges:
+        return [(start_va, end_va)]
+
+    holes = []
+    for lo, hi in sorted(data_ranges):
+        lo = max(lo, start_va)
+        hi = min(hi, end_va)
+        if hi <= lo:
+            continue
+        if holes and lo <= holes[-1][1]:
+            holes[-1] = (holes[-1][0], max(holes[-1][1], hi))
+        else:
+            holes.append((lo, hi))
+
+    spans = []
+    cur = start_va
+    for lo, hi in holes:
+        if lo > cur:
+            spans.append((cur, lo))
+        cur = max(cur, hi)
+    if cur < end_va:
+        spans.append((cur, end_va))
+    return spans
