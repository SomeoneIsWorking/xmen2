+
+
+@pytest.fixture(autouse=True)
+def _flat_image(monkeypatch):
+    """Map VA -> offset as a flat image starting at TEST_BASE."""
+    monkeypatch.setattr(recomp_config, "va_to_file_offset",
+                        lambda va: va - TEST_BASE if va >= TEST_BASE else None)
+    monkeypatch.setattr("recomp.translator.va_to_file_offset",
+                        lambda va: va - TEST_BASE if va >= TEST_BASE else None)
+    monkeypatch.setattr("recomp.translator.is_code_address",
+                        lambda va: TEST_BASE <= va < TEST_BASE + 0x100000)
+
+
+def translate(code: bytes, start: int = TEST_BASE) -> str:
+    """Translate `code` placed at `start` and return the generated C."""
+    image = bytearray(0x1000)
+    image[start - TEST_BASE:start - TEST_BASE + len(code)] = code
+    t = FunctionTranslator(bytes(image), func_db={})
+    out = t.translate_function(start, {"end": start + len(code),
+                                       "name": f"sub_{start:08X}"})
+    assert out is not None, "translator returned nothing"
+    return out
+
+
+def body_after(c: str, label: str) -> str:
+    """The generated C from `label:` to the end."""
+    i = c.index(label + ":")
+    return c[i:]
+
+
+# ── Encoding helpers (no assembler dependency) ──────────────────────────
+
+def rel8(delta):
+    return struct.pack("<b", delta)
+
+
+CMP_EBX_EAX = b"\x39\xc3"        # cmp ebx, eax
+TEST_EAX_EAX = b"\x85\xc0"       # test eax, eax
+RET = b"\xc3"
+NOP = b"\x90"
+MOV_ECX_1 = b"\xb9\x01\x00\x00\x00"
+
+
+def jne(delta):                  # 75 cb
+    return b"\x75" + rel8(delta)
+
+
+def ja(delta):                   # 77 cb
+    return b"\x77" + rel8(delta)
+
+
+def jmp(delta):                  # eb cb
+    return b"\xeb" + rel8(delta)
+
+
+# ── The behaviour that matters ──────────────────────────────────────────
+
+def test_adjacent_cmp_jcc_emits_a_real_condition():
+    """The simplest case: cmp immediately followed by its jcc."""
+    # cmp ebx, eax ; jne +1 ; nop ; ret
+    c = translate(CMP_EBX_EAX + jne(1) + NOP + RET)
+    assert "CMP_NE(" in c
+    assert "if (_flags" not in c
+
+
+def test_flags_survive_a_jump_edge():
+    """A jcc reached by a JUMP must still see the flags its predecessor set.
+
+    This is the case that was silently broken. Flag state propagated only
+    along the fall-through chain, so a block entered by a jump had none, and
+    the lifter fell back to `if (_flags ...)` -- where _flags is declared 0
+    and never assigned, making the branch impossible to take. 426 branches in
+    one real title were dead this way.
+
+    Layout, chosen so the `ja` block is reachable ONLY by the jne:
+
+        cmp ebx, eax
+        jne  L2
+        ret                 <- fall-through path ends here
+      L2:
+        ja   L3
+        ret
+      L3:
+        ret
+    """
+    # rel8 is relative to the END of the jcc, so a jump from offset 2 to
+    # offset 6 is delta 2, not 1.
+    code = (CMP_EBX_EAX +        # 0  (2)
+            jne(2) +             # 2  (2) end 4, target 6
+            RET +                # 4  (1)
+            NOP +                # 5  (1)  padding so L2 = 6
+            ja(2) +              # 6  (2) end 8, target 10
+            RET +                # 8  (1)
+            NOP +                # 9  (1)
+            RET)                 # 10 (1)  L3
+    c = translate(code)
+    tail = body_after(c, f"loc_{TEST_BASE + 6:08X}")
+    assert "if (_flags" not in tail, (
+        "the ja was emitted as the always-false fallback:\n" + tail)
+    assert "CMP_A(" in tail, "expected an 'above' comparison:\n" + tail
+
+
+def test_stale_flags_do_not_cross_a_ret():
+    """A block after a `ret` must not inherit the previous block's flags.
+
+    The mirror of the test above, and the reason the first attempt at fixing
+    it made things worse: preferring the linear fall-through state carried a
+    state across a `ret` into a block the CFG says is unrelated.
+
+        test eax, eax
+        jne  L2             <- consumes the flags
+        ret
+      L2:                   <- entered only by the jne, flags still valid
+        ja   L3
+        ...
+    """
+    code = (TEST_EAX_EAX + jne(2) + RET + NOP + ja(2) + RET + NOP + RET)
+    c = translate(code)
+    tail = body_after(c, f"loc_{TEST_BASE + 6:08X}")
+    assert "if (_flags" not in tail, tail
+
+
+def test_operands_are_snapshotted_when_the_jcc_is_not_adjacent():
+    """A deferred cmp must be evaluated on the values the FLAGS held.
+
+    `cmp eax, imm` then an instruction that overwrites eax, then the jcc: the
+    branch must test the snapshot, not the new eax.
+
+        cmp ecx, 1          (81 f9 01 00 00 00)
+        mov ecx, 1          (b9 01 00 00 00)   <- clobbers an operand
+        jne +0
+        ret
+    """
+    cmp_ecx_1 = b"\x83\xf9\x01"          # cmp ecx, 1
+    c = translate(cmp_ecx_1 + MOV_ECX_1 + jne(0) + RET)
+    assert "_flg0 = ecx;" in c, "operand was not snapshotted:\n" + c
+    # The condition must not read the register that was just overwritten.
+    cond = [l for l in c.splitlines() if "CMP_NE(" in l]
+    assert cond, "no comparison emitted:\n" + c
+    assert "_flg0" in cond[0], "condition re-read the clobbered register: " + cond[0]
+
+
+def test_no_register_is_declared_as_a_local():
+    """Every x86 register is a global; a local would break register passing."""
+    c = translate(CMP_EBX_EAX + jne(0) + RET)
+    for reg in ("eax", "ebx", "ecx", "edx", "esi", "edi", "ebp", "esp"):
+        assert f"uint32_t {reg};" not in c, f"{reg} declared as a local:\n" + c
+        assert f", {reg};" not in c, f"{reg} declared as a local:\n" + c
+
+
+def test_unconditional_jump_target_gets_a_label():
+    """A forward `jmp` inside the function must produce a reachable label."""
+    code = jmp(2) + NOP + NOP + RET   # end 2, target 4
+    c = translate(code)
+    assert f"goto loc_{TEST_BASE + 4:08X};" in c, c
+    assert f"loc_{TEST_BASE + 4:08X}:" in c, c
+    assert "DROPPED JUMP" not in c, "control flow was deleted:\n" + c
+
+
+def test_direct_calls_go_through_the_contract_check():
+    """A DIRECT call must be checkable for the callee-saved contract.
+
+    The ABI checker wraps indirect calls and says so, which leaves direct
+    calls -- the large majority -- unchecked. A callee that fails to restore
+    ebx/esi/edi/ebp corrupts its caller silently, and the damage surfaces
+    somewhere with no connection to the cause.
+
+    The emitted form must let the runtime see the target VA, so a violation
+    can name the function rather than just the register.
+    """
+    # call rel32 (e8) to a target inside the function's range, then ret.
+    #   0: e8 01 00 00 00   call +1  -> 6
+    #   5: c3               ret
+    #   6: c3               ret
+    call_rel32 = b"\xe8\x01\x00\x00\x00"
+    c = translate(call_rel32 + RET + RET)
+    assert "RECOMP_DCALL(" in c, (
+        "direct call was emitted without the contract check:\n" + c)
+    assert "0x00011006" in c.replace("0X", "0x").upper().replace("0X", "0x") or \
+           "00011006" in c, "the call site does not carry the target VA:\n" + c
+
+
+def test_esp_relative_call_target_is_read_before_the_dummy_push():
+    """`call [esp+8]` must read the slot the ORIGINAL would have read.
+
+    The macro pushes a dummy return address before dispatching, because the
+    callee's `ret` pops one. On real x86 the call computes its memory operand
+    from the esp it was reached with and pushes the return address afterwards,
+    so evaluating the operand inline in the macro read it one push too late --
+    four bytes below the function pointer.
+
+    Measured on the real title: sub_00284FE0 is `push edi; call [esp+8]`. The
+    lifted form read 0 instead of the callback it was handed, and the call did
+    not happen at all. Anything that receives a function pointer as a stack
+    argument and calls it without first loading it into a register hits this.
+    """
+    # 57            push edi
+    # ff 54 24 08   call dword ptr [esp+8]
+    # c3            ret
+    code = b"\x57" + b"\xff\x54\x24\x08" + RET
+    c = translate(code)
+
+    assert "RECOMP_ICALL_SAFE(" in c, "no indirect call was emitted:\n" + c
+    # The target must be captured into a temporary, and that read must appear
+    # BEFORE the dummy return address is pushed.
+    tgt = c.index("_icall_tgt =")
+    dummy = c.index("PUSH32(esp, 0); RECOMP_ICALL_SAFE(")
+    assert tgt < dummy, (
+        "the call target is read after the dummy return-address push, so an"
+        " esp-relative target is 4 bytes off:\n" + c)
+    assert "RECOMP_ICALL_SAFE(_icall_tgt," in c, (
+        "the macro re-reads the operand instead of using the snapshot:\n" + c)
+    # And the temporary must live inside the block that declares _icall_esp,
+    # or a second indirect call in the same function redeclares it.
+    block = c.index("{ uint32_t _icall_esp")
+    assert block < tgt, (
+        "_icall_tgt is declared outside the _icall_esp block:\n" + c)
+
+
+def test_calls_carry_their_own_guest_address_as_the_call_site():
+    """A failure report must be able to name WHICH call failed.
+
+    The native return address cannot supply it: an offset into the compiled C
+    body has no relation to an offset into the guest function, so a symbolized
+    native stack stops at "sub_002A9570 +0x1066". The call site therefore has
+    to be baked in at translation time, when it is still known exactly.
+    """
+    push_edi = b"\x57"                   # 1 byte, at TEST_BASE
+    icall    = b"\xff\x54\x24\x08"       # call dword ptr [esp+8]
+    dcall    = b"\xe8\x00\x00\x00\x00"   # call rel32 +0 -> the next instruction
+    code = push_edi + icall + dcall + RET
+    c = translate(code)
+
+    icall_site = TEST_BASE + len(push_edi)
+    dcall_site = icall_site + len(icall)
+
+    assert f"RECOMP_ICALL_SAFE(_icall_tgt, _icall_esp, 0x{icall_site:08X}u)" in c, (
+        f"the indirect call does not carry its own address 0x{icall_site:08X}"
+        f" as the call site:\n" + c)
+    assert f"0x{dcall_site:08X}u)" in c, (
+        f"the direct call does not carry its own address 0x{dcall_site:08X}"
+        f" as the call site:\n" + c)
+    # The site must be the CALL's address, not the function's start -- those
+    # coincide only for a call in the first byte of a function, which is why
+    # the fixture puts a push in front of both.
+    assert f"RECOMP_ICALL_SAFE(_icall_tgt, _icall_esp, 0x{TEST_BASE:08X}u)" not in c, (
+        "the call site is the function start, not the call instruction:\n" + c)
+
+
+def test_two_indirect_calls_in_one_function_still_compile():
+    """Each indirect call gets its own scope, so the temporaries cannot clash."""
+    icall_esp8 = b"\xff\x54\x24\x08"      # call dword ptr [esp+8]
+    code = b"\x57" + icall_esp8 + b"\x57" + icall_esp8 + RET
+    c = translate(code)
+    assert c.count("_icall_tgt =") == 2, c
+    # Every declaration is matched by an enclosing block opener.
+    assert c.count("{ uint32_t _icall_esp") == 2, (
+        "the two calls do not get separate scopes:\n" + c)
