+    spans = []
+    cur = start_va
+    for lo, hi in holes:
+        if lo > cur:
+            spans.append((cur, lo))
+        cur = max(cur, hi)
+    if cur < end_va:
+        spans.append((cur, end_va))
+    return spans
+
