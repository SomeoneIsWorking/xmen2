@@ -0,0 +1,184 @@
+"""Regression tests over real functions from a real title.
+
+Run:  python3 -m pytest tools/recomp/test_regressions.py -q
+
+test_lifter.py builds tiny synthetic sequences. Those are fast and precise but
+they only test the cases you thought of -- the first synthetic attempt at the
+flag-propagation bug passed on the BROKEN code, because the shape that
+actually breaks is not the shape that is obvious to write.
+
+So these translate named functions out of the shipped binary and assert on the
+result. Each one is anchored to a defect that really happened, with the
+observed symptom in the docstring.
+
+The binary is copyrighted and gitignored. When it is absent these SKIP with a
+reason -- they never pass quietly, because a regression suite that silently
+finds nothing to test is worse than no suite.
+"""
+
+import json
+import os
+import sys
+
+import pytest
+
+TOOLS = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ROOT = os.path.dirname(TOOLS)
+sys.path.insert(0, TOOLS)
+sys.path.insert(0, ROOT)
+
+XBE = os.path.join(ROOT, "game_files", "default.xbe")
+FUNCS = os.path.join(TOOLS, "disasm", "output", "functions.json")
+
+
+def _require_binary():
+    for path, what in ((XBE, "the game XBE"), (FUNCS, "disasm output")):
+        if not os.path.exists(path):
+            pytest.skip(f"{what} not present at {path}; these tests need the "
+                        f"real binary and were NOT run")
+
+
+@pytest.fixture(scope="module")
+def translator():
+    _require_binary()
+    from recomp import config
+    from recomp.translator import FunctionTranslator
+
+    config.configure_from_xbe(XBE)
+    data = open(XBE, "rb").read()
+
+    db = json.load(open(FUNCS))
+    db = db["functions"] if isinstance(db, dict) and "functions" in db else db
+    items = db.values() if isinstance(db, dict) else db
+    funcs = {}
+    for f in items:
+        s = f.get("start")
+        e = f.get("end")
+        s = int(s, 16) if isinstance(s, str) else s
+        e = int(e, 16) if isinstance(e, str) else e
+        if s:
+            funcs[s] = dict(f, start=s, end=e)
+    return FunctionTranslator(data, func_db=funcs), funcs
+
+
+def translate(translator, addr):
+    t, funcs = translator
+    if addr not in funcs:
+        pytest.skip(f"0x{addr:08X} is not in the current functions.json; "
+                    f"re-run tools/xbox_relift.sh")
+    out = t.translate_function(addr, funcs[addr])
+    assert out is not None, f"sub_{addr:08X} failed to translate"
+    return out
+
+
+def always_false_branches(c):
+    return [l.strip() for l in c.splitlines() if "if (_flags" in l]
+
+
+def dropped_jumps(c):
+    return [l.strip() for l in c.splitlines() if "DROPPED JUMP" in l]
+
+
+# ── Anchored regressions ────────────────────────────────────────────────
+
+def test_flag_state_reaches_a_block_entered_only_by_a_jump(translator):
+    """sub_0026E740 emitted `if (_flags /* ja */) goto loc_0026E801;`.
+
+    _flags is declared 0 and never assigned, so that branch could not be
+    taken. The block at loc_0026E7CE is reached only by a `jne` from
+    loc_0026E790, whose `cmp ebx, eax` sets the flags the `ja` consumes -- but
+    flag state propagated only along the fall-through chain, and the block
+    sitting before it in address order ends in `ret`.
+
+    Verified to discriminate: 1 always-false branch before the fix, 0 after.
+    """
+    c = translate(translator, 0x0026E740)
+    assert always_false_branches(c) == [], (
+        "a branch that can never be taken was emitted:\n  "
+        + "\n  ".join(always_false_branches(c)))
+
+
+def test_memcpy_switch_targets_are_real_gotos(translator):
+    """sub_003D5890 is the CRT memcpy.
+
+    Its tail dispatches through a jump table embedded in .text. The lifter
+    decoded the table bytes as instructions, lost sync, and the switch targets
+    got no labels -- so the missing-label pass DELETED the gotos and memcpy
+    became a no-op for any size not a multiple of 4.
+    """
+    c = translate(translator, 0x003D5890)
+    assert dropped_jumps(c) == [], (
+        "control flow was deleted from memcpy:\n  "
+        + "\n  ".join(dropped_jumps(c)))
+    assert "goto loc_003D59EC;" in c, (
+        "the switch target was not emitted as a real goto:\n" + c[:2000])
+
+
+def test_seh_function_tail_is_inside_the_function(translator):
+    """sub_00223DBD is the CRT heap create, an __SEH_prolog function.
+
+    Its boundary used to end at the last fall-through, leaving the
+    __SEH_epilog tail -- which restores ebx/esi/edi/esp/ebp -- outside the
+    function. A jump into that tail became an empty stub, so the function
+    returned with its caller's non-volatile registers destroyed.
+    """
+    _, funcs = translator
+    if 0x00223DBD not in funcs:
+        pytest.skip("0x00223DBD not in functions.json")
+    f = funcs[0x00223DBD]
+    assert f["end"] > 0x0022416C, (
+        f"function ends at 0x{f['end']:08X}, cutting off the epilogue tail "
+        f"that starts at 0x0022416C")
+
+
+def test_no_register_is_a_local_in_real_code(translator):
+    """Every register must be global, ebp included.
+
+    As a per-function local, ebp silently dropped values that FPO code carries
+    in it across an ordinary call.
+    """
+    c = translate(translator, 0x0026E740)
+    assert "uint32_t ebp;" not in c, "ebp is declared as a local:\n" + c[:800]
+
+
+@pytest.mark.parametrize("addr", [0x0026E740, 0x003D5890, 0x00223DBD,
+                                  0x002241E1, 0x00225995])
+def test_hot_functions_translate_without_deleting_control_flow(translator, addr):
+    """Nothing on the boot path may reach the "delete the jump" fallback."""
+    c = translate(translator, addr)
+    assert dropped_jumps(c) == [], (
+        f"sub_{addr:08X} lost control flow:\n  " + "\n  ".join(dropped_jumps(c)))
+    assert always_false_branches(c) == [], (
+        f"sub_{addr:08X} has branches that can never be taken:\n  "
+        + "\n  ".join(always_false_branches(c)))
+
+
+def test_a_function_behind_a_jump_table_is_detected():
+    """0x00269CA0 must exist as a function.
+
+    It is a clean 0x30-byte thiscall -- mov eax,[ecx+8] ... rep movsd ...
+    ret 8 -- and the runtime reaches it through an indirect call. It was
+    invisible to the detector because a 20-byte jump table sits at
+    0x00269C8C, immediately in front of it: the linear sweep decoded those
+    five dwords as instructions, resumed on a boundary at 0x00269C9F that
+    spans six bytes, and so no instruction started at 0x00269CA0 at all. The
+    candidate decoded to zero instructions and was dropped SILENTLY, which
+    made a seeded address look like a wrong guess.
+
+    The discovery loop stopped on it twice -- "0x00269CA0 came back after
+    being seeded" -- which is what a detector defect looks like from the
+    outside.
+    """
+    _require_binary()
+    with open(FUNCS) as f:
+        db = json.load(f)
+    fns = db["functions"] if isinstance(db, dict) and "functions" in db else db
+    starts = set()
+    for k, v in (fns.items() if isinstance(fns, dict) else
+                 ((e["start"], e) for e in fns)):
+        starts.add(int(k, 0) if isinstance(k, str) else k)
+
+    assert 0x00269CA0 in starts, (
+        "0x00269CA0 is not a detected function. The linear sweep desynchronises"
+        " on the jump table in front of it, so a candidate there must be"
+        " decoded from its own address (DisasmEngine.decode_from).")
