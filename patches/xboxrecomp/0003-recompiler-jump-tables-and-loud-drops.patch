+    def _read_jump_table_targets(self, insn, start: int, upper: int) -> List[int]:
+        """
+        Targets of an indirect `jmp [reg*scale + table]`, bounded by (start, upper).
+
+        Reads dwords at the operand's displacement while each one points inside
+        this function's window. That window IS the definition of the table's
+        extent here: an intra-function switch table is a run of pointers into
+        its own function, so the first pointer that leaves it ends the table.
+        Returns [] when the displacement is not readable or the first entry is
+        already outside -- an indirect jump through a register, or a real tail
+        call, both of which must NOT extend anything.
+        """
+        # insn.memory_ref is only set for a plain [addr] reference, never for
+        # the indexed form a jump table uses, so the displacement is parsed
+        # from the operand text here rather than widening memory_ref -- xrefs
+        # reads that field, and turning every indexed access into a data
+        # reference would be a different change with its own consequences.
+        #
+        # The SCALED INDEX is required: `jmp [eax*4 + 0x18c60]` is a table,
+        # while `jmp [edx + 0x30]` is a vtable-style dispatch through a live
+        # pointer and has no table in the image to read.
+        m = re.search(r"\[\s*e[a-z][a-z]\s*\*\s*4\s*\+\s*(0x[0-9a-fA-F]+)\s*\]",
+                      insn.op_str or "")
+        if not m:
+            return []
+        disp = int(m.group(1), 16)
+        # Walk BOTH ways from the displacement.
+        #
+        # MSVC indexes these tables with a NEGATIVE register, so the
+        # displacement is the LAST entry, not the first: memcpy's
+        # `jmp [ecx*4 + 0x3d5b28]` has its entries at 0x3d5b14..0x3d5b28
+        # (0x3d5b3c, 0x3d5b44, 0x3d5b4c, 0x3d5b54, 0x3d5b5c, 0x3d5b6f) because
+        # ecx counts the remaining dwords down through zero. Reading forward
+        # only found the single entry AT the base and stopped, which is why
+        # 0x003D5B54 -- the address the running binary asked for -- was never
+        # among the targets.
+        targets: List[int] = []
+        for i in range(256):
+            val = self.image.read_u32_at_va(disp + i * 4)
+            if val is None or not (start <= val < upper):
+                break
+            targets.append(val)
+        for i in range(1, 256):
+            val = self.image.read_u32_at_va(disp - i * 4)
+            if val is None or not (start <= val < upper):
+                break
+            targets.append(val)
+        return targets
+
