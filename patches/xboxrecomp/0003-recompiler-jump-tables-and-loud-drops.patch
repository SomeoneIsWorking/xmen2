diff --git a/tools/recomp/lifter.py b/tools/recomp/lifter.py
index a8883b5..4722b38 100644
--- a/tools/recomp/lifter.py
+++ b/tools/recomp/lifter.py
@@ -1207,7 +1207,13 @@ class Lifter:
         # The callee's 'ret' will pop it back off.
         if insn.call_target:
             name = self._call_target_name(insn.call_target)
-            lines = [f"PUSH32(esp, 0); {name}(); /* call 0x{insn.call_target:08X} */"]
+            # RECOMP_DCALL, not a bare call: it carries the target VA so the
+            # runtime can check that the callee restored ebx/esi/edi/ebp and
+            # name the offender. Direct calls are the majority, and leaving
+            # them unchecked left the contract enforced only where it was
+            # cheapest to enforce, not where it was broken.
+            lines = [f"PUSH32(esp, 0); RECOMP_DCALL({name}, 0x{insn.call_target:08X}u);"
+                     f" /* call 0x{insn.call_target:08X} */"]
             # No frame-pointer read-back: ebp is a global, so whatever
             # __SEH_prolog/__SEH_epilog does to it is already visible here.
             return lines
diff --git a/tools/recomp/test_lifter.py b/tools/recomp/test_lifter.py
index 7a012a8..eba839b 100644
--- a/tools/recomp/test_lifter.py
+++ b/tools/recomp/test_lifter.py
@@ -189,3 +189,26 @@ def test_unconditional_jump_target_gets_a_label():
     assert f"goto loc_{TEST_BASE + 4:08X};" in c, c
     assert f"loc_{TEST_BASE + 4:08X}:" in c, c
     assert "DROPPED JUMP" not in c, "control flow was deleted:\n" + c
+
+
+def test_direct_calls_go_through_the_contract_check():
+    """A DIRECT call must be checkable for the callee-saved contract.
+
+    The ABI checker wraps indirect calls and says so, which leaves direct
+    calls -- the large majority -- unchecked. A callee that fails to restore
+    ebx/esi/edi/ebp corrupts its caller silently, and the damage surfaces
+    somewhere with no connection to the cause.
+
+    The emitted form must let the runtime see the target VA, so a violation
+    can name the function rather than just the register.
+    """
+    # call rel32 (e8) to a target inside the function's range, then ret.
+    #   0: e8 01 00 00 00   call +1  -> 6
+    #   5: c3               ret
+    #   6: c3               ret
+    call_rel32 = b"\xe8\x01\x00\x00\x00"
+    c = translate(call_rel32 + RET + RET)
+    assert "RECOMP_DCALL(" in c, (
+        "direct call was emitted without the contract check:\n" + c)
+    assert "0x00011006" in c.replace("0X", "0x").upper().replace("0X", "0x") or \
+           "00011006" in c, "the call site does not carry the target VA:\n" + c
