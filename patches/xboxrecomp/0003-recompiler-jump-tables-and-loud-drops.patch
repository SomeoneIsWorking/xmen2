+    def decode_from(self, addr: int, end: int) -> int:
+        """
+        Decode starting EXACTLY at `addr`, replacing whatever the linear
+        sweep believed about [addr, end).
+
+        The sweep decodes bytes in order, so anything that is not code
+        desynchronises it: an embedded jump table is five dwords that decode
+        as some number of nonsense instructions, and the boundary it resumes
+        on is wherever those happen to end. Measured: the 20-byte table at
+        0x00269C8C left a boundary at 0x00269C9F spanning six bytes, so the
+        real function at 0x00269CA0 had no instruction starting there at all.
+        A candidate at that address then decoded to nothing and was dropped.
+
+        A known function start is authoritative over the sweep's guess, so
+        any cached instruction STRADDLING addr is provably wrong and goes.
+
+        Returns the number of instructions decoded.
+        """
+        section = self.image.get_section_at_va(addr)
+        if not section:
+            return 0
+        data = self.image.get_section_data(section)
+        if not data:
+            return 0
+
+        va_start = section.virtual_addr
+        sec_end = va_start + len(data)
+        end = min(end, sec_end)
+        if end <= addr:
+            return 0
+
+        # Drop the straddler, if any: an instruction that starts before addr
+        # and covers it cannot coexist with a function starting at addr.
+        self._ensure_sorted_addrs()
+        import bisect
+        i = bisect.bisect_left(self._sorted_addrs, addr) - 1
+        if i >= 0:
+            prev = self.instructions.get(self._sorted_addrs[i])
+            if prev is not None and prev.address + prev.size > addr:
+                del self.instructions[prev.address]
+
+        chunk = data[addr - va_start:end - va_start]
+        count = 0
+        for cs_insn in self._cs.disasm(chunk, addr):
+            insn = self._classify_instruction(cs_insn)
+            self.instructions[insn.address] = insn
+            count += 1
+
+        self._sorted_addrs = None
+        return count
+
