+/* ---- Vectored exception handling on Linux ------------------------------
+ *
+ * This was a stub returning NULL. Everything built on it was therefore dead:
+ * the crash reporter never printed, and -- the reason this matters -- the
+ * NV2A MMIO hook never ran, so a title that drives the GPU by faulting on
+ * 0xFD000000 register writes could not render one pixel no matter how far it
+ * booted.
+ *
+ * SIGSEGV carries what a VEH handler needs: si_addr is the faulting address,
+ * the page-fault error code's bit 1 is write-vs-read, and ucontext_t holds
+ * the full x86-64 register state. A handler that returns
+ * EXCEPTION_CONTINUE_EXECUTION has its (possibly edited -- the MMIO decoder
+ * advances RIP and writes a destination register) context copied back before
+ * the signal returns.
+ */
+#define XR_MAX_VEH 8
+static PVECTORED_EXCEPTION_HANDLER g_veh[XR_MAX_VEH];
+static int g_veh_count;
+static int g_veh_installed;
+
+static void xr_ctx_from_uc(XR_CONTEXT *c, const ucontext_t *uc)
+{
+    const greg_t *g = uc->uc_mcontext.gregs;
+    c->Rip = (unsigned long long)g[REG_RIP];
+    c->Rsp = (unsigned long long)g[REG_RSP];
+    c->Rbp = (unsigned long long)g[REG_RBP];
+    c->Rax = (unsigned long long)g[REG_RAX];
+    c->Rbx = (unsigned long long)g[REG_RBX];
+    c->Rcx = (unsigned long long)g[REG_RCX];
+    c->Rdx = (unsigned long long)g[REG_RDX];
+    c->Rsi = (unsigned long long)g[REG_RSI];
+    c->Rdi = (unsigned long long)g[REG_RDI];
+    c->R8  = (unsigned long long)g[REG_R8];
+    c->R9  = (unsigned long long)g[REG_R9];
+    c->R10 = (unsigned long long)g[REG_R10];
+    c->R11 = (unsigned long long)g[REG_R11];
+    c->R12 = (unsigned long long)g[REG_R12];
+    c->R13 = (unsigned long long)g[REG_R13];
+    c->R14 = (unsigned long long)g[REG_R14];
+    c->R15 = (unsigned long long)g[REG_R15];
+    c->EFlags = (DWORD)g[REG_EFL];
+}
+
+static void xr_ctx_to_uc(const XR_CONTEXT *c, ucontext_t *uc)
+{
+    greg_t *g = uc->uc_mcontext.gregs;
+    g[REG_RIP] = (greg_t)c->Rip;   g[REG_RSP] = (greg_t)c->Rsp;
+    g[REG_RBP] = (greg_t)c->Rbp;   g[REG_RAX] = (greg_t)c->Rax;
+    g[REG_RBX] = (greg_t)c->Rbx;   g[REG_RCX] = (greg_t)c->Rcx;
+    g[REG_RDX] = (greg_t)c->Rdx;   g[REG_RSI] = (greg_t)c->Rsi;
+    g[REG_RDI] = (greg_t)c->Rdi;   g[REG_R8]  = (greg_t)c->R8;
+    g[REG_R9]  = (greg_t)c->R9;    g[REG_R10] = (greg_t)c->R10;
+    g[REG_R11] = (greg_t)c->R11;   g[REG_R12] = (greg_t)c->R12;
+    g[REG_R13] = (greg_t)c->R13;   g[REG_R14] = (greg_t)c->R14;
+    g[REG_R15] = (greg_t)c->R15;   g[REG_EFL] = (greg_t)c->EFlags;
+}
+
+static void xr_sigsegv(int sig, siginfo_t *si, void *ucv)
+{
+    ucontext_t *uc = (ucontext_t *)ucv;
+    XR_CONTEXT ctx;
+    EXCEPTION_RECORD rec;
+    EXCEPTION_POINTERS ep;
+
+    xr_ctx_from_uc(&ctx, uc);
+    memset(&rec, 0, sizeof rec);
+    rec.ExceptionCode = EXCEPTION_ACCESS_VIOLATION;
+    rec.ExceptionAddress = (PVOID)(uintptr_t)ctx.Rip;
+    rec.NumberParameters = 2;
+    /* x86-64 page-fault error code bit 1 = write. */
+    rec.ExceptionInformation[0] =
+        (ULONG_PTR)((uc->uc_mcontext.gregs[REG_ERR] & 2) ? 1 : 0);
+    rec.ExceptionInformation[1] = (ULONG_PTR)si->si_addr;
+    ep.ExceptionRecord = &rec;
+    ep.ContextRecord = &ctx;
+
+    for (int i = 0; i < g_veh_count; i++) {
+        if (!g_veh[i]) continue;
+        if (g_veh[i](&ep) == EXCEPTION_CONTINUE_EXECUTION) {
+            xr_ctx_to_uc(&ctx, uc);
+            return;
+        }
+    }
+
+    /* Nobody claimed it. Restore the default action and return so the process
+       dies at the original instruction with a faithful core, rather than
+       looping on the same fault forever. */
+    {
+        struct sigaction dfl;
+        memset(&dfl, 0, sizeof dfl);
+        dfl.sa_handler = SIG_DFL;
+        sigaction(sig, &dfl, NULL);
+    }
+}
+
 PVOID AddVectoredExceptionHandler(ULONG First, PVECTORED_EXCEPTION_HANDLER Handler)
-{ (void)First; (void)Handler; return NULL; }   /* TODO: wire to sigaction */
-ULONG RemoveVectoredExceptionHandler(PVOID h) { (void)h; return 1; }
+{
+    if (!Handler || g_veh_count >= XR_MAX_VEH)
+        return NULL;
+
+    if (First && g_veh_count) {
+        memmove(&g_veh[1], &g_veh[0], (size_t)g_veh_count * sizeof g_veh[0]);
+        g_veh[0] = Handler;
+    } else {
+        g_veh[g_veh_count] = Handler;
+    }
+    g_veh_count++;
+
+    if (!g_veh_installed) {
+        /* An alternate stack: a fault deep in recompiled code can arrive with
+           very little stack left, and the handler must still run. */
+        /* glibc's SIGSTKSZ is not a constant expression; size it ourselves. */
+        static char altstack[256 * 1024];
+        stack_t ss = { .ss_sp = altstack, .ss_size = sizeof altstack, .ss_flags = 0 };
+        struct sigaction sa;
+        sigaltstack(&ss, NULL);
+        memset(&sa, 0, sizeof sa);
+        sa.sa_sigaction = xr_sigsegv;
+        sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER;
+        sigemptyset(&sa.sa_mask);
+        if (sigaction(SIGSEGV, &sa, NULL) != 0 ||
+            sigaction(SIGBUS, &sa, NULL) != 0) {
+            fprintf(stderr, "[VEH] sigaction failed (%s): exception handlers "
+                            "are NOT installed, so GPU MMIO faults will kill "
+                            "the process instead of being emulated\n",
+                    strerror(errno));
+            fflush(stderr);
+            return NULL;
+        }
+        g_veh_installed = 1;
+    }
+    return (PVOID)Handler;
+}
+
+ULONG RemoveVectoredExceptionHandler(PVOID h)
+{
+    for (int i = 0; i < g_veh_count; i++) {
+        if (g_veh[i] == (PVECTORED_EXCEPTION_HANDLER)h) {
+            memmove(&g_veh[i], &g_veh[i + 1],
+                    (size_t)(g_veh_count - i - 1) * sizeof g_veh[0]);
+            g_veh_count--;
+            return 1;
+        }
+    }
+    return 0;
+}
 
 #endif /* !_WIN32 */
+
+/* ---- Entry-point helpers ----------------------------------------------
+ * A game's main.c synthesises WinMain arguments from these. On Linux there is
+ * no Win32 process command line, so reconstruct one from /proc/self/cmdline;
+ * returning an empty string would silently drop arguments the game parses.
+ */
+static char g_cmdline[4096];
+
+LPSTR GetCommandLineA(void)
+{
+    if (!g_cmdline[0]) {
+        FILE *f = fopen("/proc/self/cmdline", "rb");
+        size_t n = 0;
+        if (f) {
+            n = fread(g_cmdline, 1, sizeof g_cmdline - 1, f);
+            fclose(f);
+            /* /proc gives NUL-separated argv; Win32 wants one space-separated
+               string. */
+            for (size_t i = 0; i + 1 < n; i++)
+                if (g_cmdline[i] == '\0') g_cmdline[i] = ' ';
+        }
+        g_cmdline[n] = '\0';
+    }
+    return g_cmdline;
+}
+
+HMODULE GetModuleHandleA(LPCSTR name)
+{
+    /* NULL means "this process's image base". Nothing in the recompiled game
+       dereferences it as a real PE base -- it is passed straight back into
+       WinMain as hInstance -- so a stable non-NULL token is sufficient, and a
+       named lookup has no meaning here. */
+    (void)name;
+    return (HMODULE)(void *)&g_cmdline;
+}
